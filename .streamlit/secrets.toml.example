# Copy this file to .streamlit/secrets.toml for local testing, or paste the same
# keys into Streamlit Community Cloud: App → Settings → Secrets.
# Never commit the real secrets.toml (it is in .gitignore).

# Password visitors must enter before they can use the app (and your API key).
APP_PASSWORD = "choose-a-strong-password"

# LLM provider key — set the one that matches LLM_MODEL.
OPENAI_API_KEY = "sk-..."
# ANTHROPIC_API_KEY = "..."
# GEMINI_API_KEY = "..."

# Any LiteLLM model string (default: gpt-4.1-mini)
LLM_MODEL = "gpt-4.1-mini"
