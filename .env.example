# LiteLLM reads the provider key matching your model, e.g.:
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...
# GEMINI_API_KEY=...

# Any LiteLLM model string (default: gpt-4.1-mini)
LLM_MODEL=gpt-4.1-mini

# Optional locally: require a password even when running from .env
# APP_PASSWORD=choose-a-strong-password
